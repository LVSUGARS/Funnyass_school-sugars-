<?xml version="1.0" encoding="utf-8"?>
<!--
    登录采用「先选择、再输入」两步，三个分组互斥显示：

      1. login_picker_group：只有这一页有 Logo + 标题，两个登录方式按钮贴底，方便拇指点按
      2. login_code_group / login_pwd_group：独立输入页，没有 Logo，只保留返回 + 表单

    根布局用 Base.LayoutParams 贴到窗口内容区底部，避开导航栏；
    键盘内边距只加在输入区（login_scroll）上，选择页不受影响。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_bg"
    android:orientation="vertical">

    <!-- ==================== 1. 选择页 ==================== -->

    <LinearLayout
        android:id="@+id/login_picker_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="25dp">

        <!-- Logo 放在上方约 1/3 处：空间足够，不必再挤在顶部 -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!--
              登录页 Logo 直接使用软件图标（与桌面图标同款）。
              原先是蓝色圆底 + 白色水滴矢量图，与图标不一致。
              图标本身是带圆角与底色的位图，因此这里不再加背景、内边距和 tint。
            -->
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="睿智校园"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_ruizhi_no_ads" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="睿智校园"
                android:textColor="@color/apple_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="校园热水 · 清爽无打扰"
                android:textColor="@color/apple_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pick_pwd_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="密码登录"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/apple_blue"
            app:cornerRadius="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pick_code_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="验证码登录"
            android:textAllCaps="false"
            android:textColor="@color/apple_text"
            android:textSize="16sp"
            app:backgroundTint="@color/apple_neutral_tint"
            app:cornerRadius="26dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="登录后仅访问校园账户和公寓热水服务"
            android:textColor="@color/apple_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ==================== 2. 输入页（无 Logo） ==================== -->

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/login_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="25dp">

            <LinearLayout
                android:id="@+id/login_back"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_apple_arrow_back" />

                <TextView
                    android:id="@+id/login_back_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="返回"
                    android:textColor="@color/apple_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="手机号"
                android:textColor="@color/apple_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_apple_field"
                android:hint="请输入手机号"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/apple_text"
                android:textColorHint="@color/apple_secondary"
                android:textSize="15sp" />

            <!-- 验证码输入页 -->
            <LinearLayout
                android:id="@+id/login_code_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="验证码"
                    android:textColor="@color/apple_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/code"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_apple_field"
                        android:hint="请输入验证码"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/apple_text"
                        android:textColorHint="@color/apple_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="获取验证码"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:backgroundTint="@color/apple_blue"
                        app:cornerRadius="13dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/login_error_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="18dp"
                    android:textColor="@color/apple_red"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/code_login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="登录"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/apple_blue"
                    app:cornerRadius="26dp" />
            </LinearLayout>

            <!-- 密码输入页 -->
            <LinearLayout
                android:id="@+id/login_pwd_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="密码"
                    android:textColor="@color/apple_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_apple_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/pwd"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="请输入密码"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/apple_text"
                        android:textColorHint="@color/apple_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/pwd_toggle"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="👁"
                        android:textColor="@color/apple_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/login_error_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="18dp"
                    android:textColor="@color/apple_red"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pwd_login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="登录"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/apple_blue"
                    app:cornerRadius="26dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
