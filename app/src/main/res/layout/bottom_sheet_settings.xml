<?xml version="1.0" encoding="utf-8"?>
<!--
  设置底部弹窗（契约 5.2 / apple-design-preview.html 行 838-873）
  由 activity_bath.xml 的 FrameLayout 用 <include> 引入并贴底显示：
    - 根布局只给 match_parent x wrap_content，不写 layout_gravity / 高度上限
    - advanced_toggle 就是「诊断日志」这一行（契约禁止另造 settings_diagnostics）
    - 所有 id 会被合并进宿主视图树，BathActivity 直接 findViewById 可取
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_apple_sheet_rounded_top"
    android:orientation="vertical">

    <!-- 抓手（HTML .sheet-grabber） -->
    <View
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_apple_grabber" />

    <!-- 头部：眉标 + 标题 + 关闭 ×；固定在滚动区之外，保证始终可见 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="SETTINGS"
                android:textColor="@color/apple_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="设置"
                android:textColor="@color/apple_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_apple_secondary_btn"
            android:clickable="true"
            android:contentDescription="关闭"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/apple_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 滚动区：展开诊断日志后总高可能变大，小屏靠这里滚动，根布局始终 wrap_content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 账户卡（HTML .account-hero） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_apple_block"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/account_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_apple_circle_surface"
                    android:clickable="true"
                    android:contentDescription="修改头像"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_apple_account" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="账号"
                            android:textColor="@color/apple_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/settings_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="--"
                            android:textColor="@color/apple_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="余额"
                            android:textColor="@color/apple_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/settings_wallet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="--"
                            android:textColor="@color/apple_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/settings_refresh"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_apple_circle_surface"
                    android:clickable="true"
                    android:contentDescription="刷新账户"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_apple_refresh" />
            </LinearLayout>

            <!-- ===== 操作列表（HTML .account-actions） ===== -->

            <!-- 检查更新 -->
            <LinearLayout
                android:id="@+id/settings_check_update"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_apple_action_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查更新"
                        android:textColor="@color/apple_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
            android:text="当前版本 1.0.3"
                        android:textColor="@color/apple_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/apple_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 使用记录：点击跳到全屏页（原折叠区空间太小，已移除） -->
            <LinearLayout
                android:id="@+id/usage_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_apple_action_row"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:text="使用记录"
                    android:textColor="@color/apple_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp"
                    android:text="›"
                    android:textColor="@color/apple_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 诊断日志：点击跳到全屏页（advanced_toggle 即本行，契约 5.2） -->
            <LinearLayout
                android:id="@+id/advanced_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_apple_action_row"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:text="诊断日志"
                    android:textColor="@color/apple_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp"
                    android:text="›"
                    android:textColor="@color/apple_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 重新登录：危险红字，置底。
                 用 TextView 而非 MaterialButton：后者会强制套用自己的填充背景，
                 覆盖这里的 drawable。 -->
            <TextView
                android:id="@+id/relogin_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_apple_secondary_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="重新登录"
                android:textColor="@color/apple_red"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
