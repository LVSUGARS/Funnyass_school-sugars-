<?xml version="1.0" encoding="utf-8"?>
<!--
  使用记录全屏页。
  由 activity_bath.xml 用 <include> 引入，盖在设置 sheet 之上；点左上角返回回到设置页。
  原先是设置页里的 140dp 折叠区，空间太小，改为整页。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_bg"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp">

    <!-- 头部：返回 + 标题 + 清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/usage_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="返回"
                android:src="@drawable/ic_apple_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="返回"
                android:textColor="@color/apple_text"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/usage_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:text="使用记录"
            android:textColor="@color/apple_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/usage_clear"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="清空"
            android:textColor="@color/apple_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 列表主体：占满剩余高度，可滚动 -->
    <TextView
        android:id="@+id/usage_page_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:lineSpacingExtra="10dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical"
        android:text="暂无使用记录"
        android:textColor="@color/apple_text"
        android:textIsSelectable="true"
        android:textSize="14sp" />
</LinearLayout>
