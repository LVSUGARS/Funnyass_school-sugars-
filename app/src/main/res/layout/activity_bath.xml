<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bath_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_bg">

    <!-- The four vertical zones mirror the HTML: title, centered gauge, device copy, controls. -->
    <LinearLayout
        android:id="@+id/bath_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="WATER CONTROL"
                    android:textColor="@color/apple_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="洗澡仪表盘"
                    android:textColor="@color/apple_text"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <ImageButton
                android:id="@+id/settings_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_apple_circle_surface"
                android:contentDescription="设置"
                android:elevation="0dp"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_apple_settings" />
        </LinearLayout>

        <!-- This weighted zone is bounded by the title and device copy, so the gauge cannot drift. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <com.funnyass.test.ui.BathGaugeView
                android:id="@+id/bath_gauge"
                android:layout_width="232dp"
                android:layout_height="232dp"
                android:layout_gravity="center"
                android:contentDescription="洗澡状态仪表盘" />
        </FrameLayout>

        <!-- Device copy belongs to the control stack below it, as in the HTML full-device-zone. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="请选择洗澡设备"
                android:textColor="@color/apple_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/device_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="点击下方蓝牙设备卡片扫描附近设备"
                android:textColor="@color/apple_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/connection_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_apple_dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="未连接"
                    android:textColor="@color/apple_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/device_entry_btn"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_apple_dashboard_card"
                android:clickable="true"
                android:elevation="0dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="蓝牙设备"
                        android:textColor="@color/apple_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/device_entry_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="未连接"
                        android:textColor="@color/apple_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="选择设备"
                    android:src="@drawable/ic_apple_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_apple_dashboard_card"
                    android:elevation="0dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/stat1_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="协议"
                        android:textColor="@color/apple_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/stat1_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="@color/apple_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_apple_dashboard_card"
                    android:elevation="0dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/stat2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="水阀"
                        android:textColor="@color/apple_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/stat2_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="--"
                        android:textColor="@color/apple_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/start_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="开始洗澡"
                    android:textAllCaps="false"
                    android:textColor="@color/apple_primary_button_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/apple_primary_button_bg"
                    app:cornerRadius="25dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stop_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="停止并结算"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/apple_red"
                    app:cornerRadius="25dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Legacy data targets retained for the existing controller; none is a second visible action. -->
        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone">
            <TextView android:id="@+id/wallet" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/account_subtitle" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/account_value" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/connection_value" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/control_hint" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/refresh_btn" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/apple_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <include
        android:id="@+id/picker_sheet"
        layout="@layout/bottom_sheet_device_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <include
        android:id="@+id/settings_sheet"
        layout="@layout/bottom_sheet_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!--
      使用记录 / 诊断日志的全屏页。
      原来是设置 sheet 内的折叠区（120~140dp），空间太小、看着累；
      改为点击后整页展示，返回即回到设置页。
      放在布局最后 → 天然盖在 sheet 与 scrim 之上。
    -->
    <include
        android:id="@+id/usage_page"
        layout="@layout/page_usage_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <include
        android:id="@+id/diagnostics_page"
        layout="@layout/page_diagnostics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
