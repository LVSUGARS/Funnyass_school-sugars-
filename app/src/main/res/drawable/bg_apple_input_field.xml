<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框底：中性底 + 1dp 边 + 14dp 圆角（对应 HTML .picker-input） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/apple_neutral_tint" />
    <stroke
        android:width="1dp"
        android:color="@color/apple_line" />
    <corners android:radius="14dp" />
</shape>
